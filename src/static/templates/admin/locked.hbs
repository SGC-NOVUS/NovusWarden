<main class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 80vh; padding: 20px;">
    <div style="width: 100%; max-width: 520px; background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(16px); border: 2px solid #ef4444; border-radius: 16px; box-shadow: 0 20px 50px rgba(239, 68, 68, 0.25), 0 0 30px rgba(0, 0, 0, 0.8); padding: 40px 32px; color: #f8fafc; text-align: center;">
        <!-- Red Shield Icon -->
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; border-radius: 20px; background: rgba(239, 68, 68, 0.15); border: 1px solid #ef4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.4); margin-bottom: 20px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                <line x1="8" y1="16" x2="8" y2="16"></line>
                <line x1="12" y1="16" x2="12" y2="16"></line>
                <line x1="16" y1="16" x2="16" y2="16"></line>
            </svg>
        </div>

        <h1 style="font-size: 22px; font-weight: 700; color: #f87171; margin: 0 0 8px 0;">
            Панель управления заблокирована
        </h1>
        <p style="font-size: 13px; color: #cbd5e1; margin: 0 0 24px 0; line-height: 1.5;">
            Система безопасности <strong>Novus Sentinel</strong> зафиксировала 2 неудачных попытки авторизации. В целях предотвращения подбора пароля страница администратора полностью деактивирована.
        </p>

        <!-- Incident Telemetry Card -->
        <div style="background: #111827; border: 1px solid #374151; border-radius: 10px; padding: 18px 20px; text-align: left; margin-bottom: 24px; font-size: 13px;">
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #9ca3af; letter-spacing: 0.5px; margin-bottom: 12px; border-bottom: 1px solid #1f2937; padding-bottom: 6px;">
                Параметры зафиксированного инцидента
            </div>
            <div style="margin-bottom: 8px;">
                <span style="color: #94a3b8;">IP-адрес:</span>
                <span style="font-family: monospace; color: #f87171; font-weight: 600; margin-left: 6px;">{{last_ip}}</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span style="color: #94a3b8;">Геолокация:</span>
                <span style="color: #f1f5f9; font-weight: 500; margin-left: 6px;">{{last_location}}</span>
            </div>
            <div style="margin-bottom: 8px;">
                <span style="color: #94a3b8;">Клиент:</span>
                <span style="color: #cbd5e1; font-size: 12px; margin-left: 6px; word-break: break-all;">{{last_user_agent}}</span>
            </div>
            <div>
                <span style="color: #94a3b8;">Время фиксации:</span>
                <span style="color: #f1f5f9; margin-left: 6px;">{{lockout_time}}</span>
            </div>
        </div>

        <!-- Instructions -->
        <div style="background: rgba(2, 132, 199, 0.1); border: 1px solid rgba(56, 189, 248, 0.3); border-radius: 10px; padding: 16px; margin-bottom: 24px; text-align: left;">
            <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 20px;">📧</span>
                <div style="font-size: 13px; line-height: 1.5; color: #bae6fd;">
                    <strong>Письмо для разблокировки отправлено!</strong>
                    <br>
                    На почту администратора выслано экстренное уведомление с криптографической одноразовой ссылкой. Для восстановления доступа откройте письмо и нажмите кнопку <em>«Разблокировать панель управления»</em>.
                </div>
            </div>
        </div>

        <p style="font-size: 12px; color: #64748b; margin: 0;">
            Novus Sentinel Security Protocol • SGC-NOVUS Cyber Defense
        </p>
    </div>
</main>
