<!DOCTYPE html>
<html lang="{{#if lang}}{{lang}}{{else}}en{{/if}}" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>404 — {{t "web.404.title" locale=lang}} | NovusWarden</title>
    <link rel="icon" type="image/x-icon" href="{{urlpath}}/vw_static/favicon.ico?v=20261102" />
    <link rel="icon" type="image/png" sizes="32x32" href="{{urlpath}}/vw_static/favicon-32x32.png?v=20261102" />
    <link rel="icon" type="image/png" sizes="16x16" href="{{urlpath}}/vw_static/favicon-16x16.png?v=20261102" />
    <link rel="apple-touch-icon" sizes="180x180" href="{{urlpath}}/vw_static/apple-touch-icon.png?v=20261102" />
    <style>
        :root {
            --bg: #030712;
            --grad: radial-gradient(ellipse at 50% 0%, #0b1933 0%, #050b18 55%, #02060f 100%);
            --card: rgba(13, 22, 41, 0.88);
            --border: rgba(56, 189, 248, 0.28);
            --text: #f8fafc;
            --muted: #94a3b8;
            --subtle: #64748b;
            --badge-bg: rgba(14, 165, 233, 0.12);
            --badge-border: rgba(56, 189, 248, 0.3);
            --secondary-bg: rgba(255, 255, 255, 0.07);
            --secondary-border: rgba(255, 255, 255, 0.14);
        }
        @media (prefers-color-scheme: light) {
            html:not(.dark) {
                --bg: #f1f5f9;
                --grad: radial-gradient(ellipse at 50% 0%, #ffffff 0%, #f1f5f9 55%, #e2e8f0 100%);
                --card: rgba(255, 255, 255, 0.96);
                --border: rgba(15, 23, 42, 0.12);
                --text: #0f172a;
                --muted: #475569;
                --subtle: #64748b;
                --badge-bg: rgba(2, 132, 199, 0.08);
                --badge-border: rgba(2, 132, 199, 0.28);
                --secondary-bg: rgba(15, 23, 42, 0.05);
                --secondary-border: rgba(15, 23, 42, 0.16);
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background: var(--bg);
            background-image: var(--grad);
            color: var(--text);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 18px 20px 14px;
        }
        header {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand img { height: 36px; width: auto; display: block; }
        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 0;
        }
        .card {
            width: 100%;
            max-width: 480px;
            padding: 36px 32px;
            border-radius: 20px;
            background: var(--card);
            border: 1px solid var(--border);
            box-shadow: 0 24px 54px -12px rgba(0, 0, 0, 0.6), 0 0 32px rgba(14, 165, 233, 0.12);
            backdrop-filter: blur(18px);
            text-align: center;
        }
        .code-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 5px 14px;
            border-radius: 999px;
            background: var(--badge-bg);
            border: 1px solid var(--badge-border);
            color: #38bdf8;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 14px;
        }
        .code-num {
            font-size: 72px;
            line-height: 1;
            font-weight: 800;
            letter-spacing: -0.04em;
            margin: 4px 0 12px;
            background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        h1 {
            font-size: 21px;
            font-weight: 700;
            margin: 0 0 8px;
            letter-spacing: -0.02em;
        }
        p.lead {
            font-size: 13.5px;
            line-height: 1.55;
            color: var(--muted);
            margin: 0 0 24px;
        }
        .actions {
            display: flex;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .btn-primary, .btn-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 40px;
            padding: 0 20px;
            border-radius: 10px;
            font-size: 13.5px;
            font-weight: 600;
            text-decoration: none;
            transition: transform 0.18s ease, filter 0.18s ease;
        }
        .btn-primary {
            background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(2, 132, 199, 0.35);
        }
        .btn-primary:hover { filter: brightness(1.1); transform: translateY(-1px); }
        .btn-secondary {
            background: var(--secondary-bg);
            border: 1px solid var(--secondary-border);
            color: var(--text);
        }
        .btn-secondary:hover { filter: brightness(1.1); transform: translateY(-1px); }
        footer {
            text-align: center;
            font-size: 11.5px;
            color: var(--subtle);
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <header>
        <a class="brand" href="{{urlpath}}/">
            <img src="{{urlpath}}/vw_static/novuswarden_banner_black_trans.webp" alt="NovusWarden" />
        </a>
    </header>

    <main>
        <section class="card">
            <div class="code-pill">HTTP 404 · Zero-Knowledge Vault</div>
            <div class="code-num">404</div>
            <h1>{{t "web.404.title" locale=lang}}</h1>
            <p class="lead">{{t "web.404.lead" locale=lang}}</p>
            <div class="actions">
                <a class="btn-primary" href="{{urlpath}}/">{{t "web.404.return_link" locale=lang}}</a>
                <a class="btn-secondary" href="https://github.com/SGC-NOVUS/NovusWarden" target="_blank" rel="noopener noreferrer">{{t "web.404.contact_link" locale=lang}}</a>
            </div>
        </section>
    </main>

    <footer>
        <div>{{t "web.404.footer" locale=lang}}</div>
        <div>NovusWarden • System Generations Core Novus</div>
    </footer>
</body>
</html>
