{
  "name": "novuswarden-frontend",
  "version": "1.0.0",
  "description": "NovusWarden Control Plane and Modern Email Template Builder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:admin && npm run build:vault && npm run build:emails",
    "build:admin": "vite build --mode admin",
    "build:vault": "vite build --mode vault",
    "build:emails": "node ./emails/compile-emails.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vue-email/compiler": "^0.8.14",
    "@vueuse/core": "^12.0.0",
    "hash-wasm": "^4.12.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-email": "^0.8.11",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
