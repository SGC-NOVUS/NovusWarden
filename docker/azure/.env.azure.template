## =====================================================================
## NovusWarden Production Environment for Microsoft Azure
## Optimized for: Azure VM B2 (2 vCPU, 1 GB RAM) + PostgreSQL Flexible Server B1ms
## Enterprise Security Edition by SGC-NOVUS (System Generations Core Novus)
## =====================================================================

## 1. Domain & Vault Identity
DOMAIN=https://vault.yourdomain.com
ROCKET_PORT=8000
ROCKET_ADDRESS=127.0.0.1
WEB_VAULT_ENABLED=true

## 2. Azure Flexible PostgreSQL Database (B1ms Hardened)
## Format: postgresql://<user>:<password>@<server-name>.postgres.database.azure.com:5432/<dbname>?sslmode=require
DATABASE_URL=postgresql://novus_admin:REPLACE_WITH_STRONG_AZURE_PASSWORD@novus-postgres-b1.postgres.database.azure.com:5432/novuswarden?sslmode=require

## Strict Connection Pooling (Crucial for 1GB RAM VM & B1ms burstable tier)
DATABASE_MAX_CONNS=5
DATABASE_TIMEOUT=30

## 3. Server Threading & Memory Optimization (1GB RAM Protection)
ROCKET_WORKERS=4
ROCKET_LIMITS="{json=5242880}"
ENABLE_MIMALLOC=true

## 4. Cryptographic & Administrative Security
## Generate with: docker run --rm -it ghcr.io/sgc-novus/novuswarden:latest /novuswarden hash
ADMIN_TOKEN=$argon2id$v=19$m=65536,t=3,p=4$REPLACE_WITH_ARGON2_HASH

## Signups and Invitations (Zero Unauthorized Registrations)
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
INVITATION_ORG_NAME=NovusWarden

## Password Iterations (OWASP recommended standard)
PASSWORD_ITERATIONS=600000

## 5. Rate Limiting & Anti-Bruteforce Defense
IP_HEADER=X-Forwarded-For
LOGIN_RATELIMIT_MAX_BURST=10
LOGIN_RATELIMIT_SECONDS=60
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_RATELIMIT_SECONDS=300

## 6. Email / SMTP Security (TLS Encrypted)
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=smtp-user
SMTP_PASSWORD=smtp-password
SMTP_FROM=no-reply@yourdomain.com
SMTP_FROM_NAME=NovusWarden Security

## 7. Storage & Logging
DATA_FOLDER=/data
LOG_LEVEL=info
EXTENDED_LOGGING=true
LOG_FILE=/data/novuswarden.log

